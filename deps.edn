{:paths ["src/clj" "resources"]
 :deps  {org.clojure/clojure             {:mvn/version "1.11.1"}
         org.clojure/core.async          {:mvn/version "1.6.681"}
         ;; RPI
         com.diozero/diozero-core        {;; :mvn/version "1.4.0"
                                          :local/root "/home/admin/diozero/diozero-core/target/diozero-core-1.4.0.jar"}
         ;; Media
         uk.co.caprica/vlcj              {:mvn/version "4.8.2"}
         ;; Homeassistant integration via MQTT
         clojurewerkz/machine_head       {:mvn/version "1.0.0"}
         ;; Database
         duratom/duratom                 {:mvn/version "0.5.9"}
         ;; Util
         medley/medley                   {:mvn/version "1.4.0"}
         ;; Routing
         metosin/reitit                  {:mvn/version "0.6.0"}
         ;; Ring
         metosin/ring-http-response      {:mvn/version "0.9.3"}
         ring/ring-core                  {:mvn/version "1.10.0"}
         ring/ring-defaults              {:mvn/version "0.4.0"}
         ;; Logging
         ch.qos.logback/logback-classic  {:mvn/version "1.4.14"}
         ;; Data coercion
         luminus-transit/luminus-transit {:mvn/version "0.1.6"}
         metosin/muuntaja                {:mvn/version "0.6.8"}
         ;; HTML and CSS
         com.thheller/shadow-css         {:mvn/version "0.4.4"}
         simpleui/simpleui               {:git/url "https://github.com/whamtet/simpleui",
                                          :git/sha "2edfe71d9deaef58d1547dae060215c2bea7a208"}
         ;; Events
         jp.nijohando/event              {:git/url "https://github.com/Ramblurr/event"
                                          :git/sha "9cb238a9ea2f4cb972289b532c0612c9598fb686"}

         ;; kit Libs
         io.github.kit-clj/kit-core     {:mvn/version "1.0.5"}
         io.github.kit-clj/kit-undertow {:mvn/version "1.0.6"}
         io.github.kit-clj/kit-nrepl    {:mvn/version "1.0.3"}}
 :aliases {:build      {:deps       {io.github.clojure/tools.build {:mvn/version "0.9.6"}}
                        :ns-default build}
           :dev        {:extra-deps  {com.lambdaisland/classpath      {:mvn/version "0.4.44"}
                                      criterium/criterium             {:mvn/version "0.4.6"}
                                      expound/expound                 {:mvn/version "0.9.0"}
                                      integrant/repl                  {:mvn/version "0.3.3"}
                                      mvxcvi/cljstyle                 {:mvn/version "0.15.1"}
                                      pjstadig/humane-test-output     {:mvn/version "0.11.0"}
                                      ring/ring-devel                 {:mvn/version "1.10.0"}
                                      ring/ring-mock                  {:mvn/version "0.4.0"}
                                      io.github.kit-clj/kit-generator {:mvn/version "0.1.8"}
                                      org.clojure/tools.namespace     {:mvn/version "1.4.4"}
                                      com.clojure-goes-fast/virgil    {:mvn/version "0.2.0"}
                                      djblue/portal                   {:mvn/version "0.51.0"}}
                        :extra-paths ["env/dev/clj" "env/dev/resources" "test/clj"]
                        :jvm-opts    ["-XX:-OmitStackTraceInFastThrow"]}
           :nrepl      {:extra-deps {nrepl/nrepl {:mvn/version "1.1.0"}}
                        :main-opts  ["-m" "nrepl.cmdline" "-i"]}
           :remote-dev {:extra-deps {refactor-nrepl/refactor-nrepl {:mvn/version "3.9.1"}
                                     nrepl/nrepl                   {:mvn/version "1.1.0"}
                                     cider/cider-nrepl             {:mvn/version "0.44.0"}}
                        :main-opts  ["-m" "nrepl.cmdline"
                                     "--middleware" "[refactor-nrepl.middleware/wrap-refactor,cider.nrepl/cider-middleware,portal.nrepl/wrap-portal]"
                                     "--bind" "0.0.0.0"
                                     "--port" "7002"]}
           :test       {:extra-deps  {criterium/criterium                  {:mvn/version "0.4.6"}
                                      expound/expound                      {:mvn/version "0.9.0"}
                                      integrant/repl                       {:mvn/version "0.3.3"}
                                      io.github.cognitect-labs/test-runner {:git/url "https://github.com/cognitect-labs/test-runner.git"
                                                                            :git/tag "v0.5.1"
                                                                            :git/sha "dfb30dd"}
                                      pjstadig/humane-test-output          {:mvn/version "0.11.0"}
                                      ring/ring-devel                      {:mvn/version "1.10.0"}
                                      ring/ring-mock                       {:mvn/version "0.4.0"}
                                      io.github.kit-clj/kit-generator      {:mvn/version "0.1.8"}
                                      org.clojure/tools.namespace          {:mvn/version "1.4.4"}
                                      com.lambdaisland/classpath           {:mvn/version "0.4.44"}}
                        :exec-fn     cognitect.test-runner.api/test
                        :extra-paths ["env/dev/clj" "env/dev/resources" "env/test/resources" "test/clj"]
                        :main-opts   ["-e" "(require 'pjstadig.humane-test-output) (pjstadig.humane-test-output/activate!)"
                                      "-m" "cognitect.test-runner"]}}}
