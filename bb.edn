{:min-bb-version "0.8.156"

 :deps  {failjure/failjure       {:mvn/version "2.3.0"}
         com.thheller/shadow-css {;; :git/url "https://github.com/thheller/shadow-css.git"
                                  ;; :git/sha "b3c97fe3caf16fab1a90fb93a7baad76fe15aa46"
                                  :mvn/version "0.6.1"}}
 :pods  {org.babashka/fswatcher {:version "0.0.5"}}
 :paths ["resources" "scripts"]
 :tasks {:requires         ([babashka.fs :as fs]
                            [clojure.string :as str]
                            [babashka.tasks :refer [shell]])
         remote-dev        {:doc  "Start nREPL for remote development. Designed to be ran on the RPI"
                            :task (clojure {:extra-env {"NREPL_HOST" "0.0.0.0"}} "-M:dev:remote-dev")}
         run               {:doc  "starts the app"
                            :task (clojure "-m fairy.box.core")}
         nrepl             {:doc  "starts the nREPL"
                            :task (clojure "-M:dev:nrepl")}
         cider             {:doc  "starts the cider"
                            :task (clojure "-M:dev:cider")}
         test              {:doc  "runs tests"
                            :task (clojure "-M:test")}
         uberjar           {:doc  "builds the uberjar"
                            :task (clojure "-T:build all")}
         format            {:doc  "Formats codebase"
                            :task (try
                                    (shell {:dir "src"} "cljstyle fix")
                                    (catch Exception _
                                      (clojure {:dir "src"} "-M:dev -m cljstyle.main fix")))}
         watch             {:requires ([pod.babashka.fswatcher :as fw])
                            :task     (exec 'watch/dev-watch)}
         sync              {:task (exec 'sync/do-sync!)}
         css-dev           {:task (exec 'css/css-dev)}
         css-release       {:task (exec 'css/css-release)}
         credits           {:task (exec 'credits/build-attribution)}
         fmt               (shell "cljfmt -v fix .")
         lint.copy-configs (let [cp (-> (shell {:out :string} "clojure -Spath -M:test:dev") :out str/trim)]
                             (shell (str "clj-kondo --lint " cp " --dependencies --copy-configs --skip-lint")))
         lint.kondo        (shell "clj-kondo" *command-line-args*)
         lint              (shell (str "clj-kondo" " --fail-level error"
                                       (if (seq *command-line-args*)
                                         (str " --lint " (first *command-line-args*))
                                         " --lint .")))}}
