{:hifi/project {:name        fairy/box
                :version     "0.0.1"
                :description "screenless RFID raspberry pi audio player for children "
                :license     "EUPL-1.2"
                :main-ns     fairy.box.core}

 :fairy.box/components
 {:fairy.box/settings {:fairybox-id #or [#env FAIRYBOX_ID "" "test"]
                       :media       {:media-dir #or [#profile {:dev-no-rpi "../../sparklestories/media"} #env MEDIA_DIR "/srv/media"]}
                       :shutdown    {:type :pimoroni-onoff-shim}
                       :sfx         {:shutdown    "sfx/sergequadrado__celtic-positive-intro.mp3"
                                     :startup     "sfx/sergequadrado__magic-harp-logo.mp3"
                                     :tts-problem "sfx/tts-sorry-problem.wav"}}

  :fairy.box.db/db   {:path #or [#profile {:dev-no-rpi "./data/db.edn"}
                                 #env DB_PATH "/var/lib/fairybox/db.edn"]}
  :fairy.box.bus/bus {}}

 :hifi/middleware
 {:csrf-protection {:csrf-secret
                    #hifi/secret #profile     {:dev        "stebJ-BjAvs8THKz_UgwSL8f0rDzrEem_LWJb4qZ9q4"
                                               :dev-no-rpi "stebJ-BjAvs8THKz_UgwSL8f0rDzrEem_LWJb4qZ9q4"
                                               :default    #env "CSRF_SECRET"}
                    :cookie-attrs {:same-site   :lax
                                   :path        "/"
                                   :secure      #profile {:dev false :dev-no-rpi false :default true}
                                   :host-prefix #profile {:dev false :dev-no-rpi false :default true}}}}}
