{:fairy.box/components
 {:fairy.box/settings         {:fairybox-id #or [#env FAIRYBOX_ID "" "test"]
                               :media       {:media-dir #or [#env MEDIA_DIR
                                                            #profile {:dev-no-rpi "../../sparklestories/media"
                                                                      :test       "./data/test-media"
                                                                      :default    "/srv/media"}]}
                               :shutdown    {:type :pimoroni-onoff-shim}
                               :sfx         {:shutdown    "sfx/sergequadrado__celtic-positive-intro.mp3"
                                             :startup     "sfx/sergequadrado__magic-harp-logo.mp3"
                                             :tts-problem "sfx/tts-sorry-problem.wav"}}

  :fairy.box.db/db            {:path #or [#env DB_PATH
                                          #profile {:dev-no-rpi "./data/db.edn"
                                                    :test       "./data/test-db.edn"
                                                    :default    "/var/lib/fairybox/db.edn"}]}

  :fairy.box.bus/bus          {}

  :fairy.box.hardware/enabled {:rfid    #boolean #or [#env HARDWARE_RFID_ENABLED
                                                       #profile {:dev        true
                                                                 :dev-no-rpi true
                                                                 :test       true
                                                                 :prod       true
                                                                 :default    true}]
                               :buttons #boolean #or [#env HARDWARE_BUTTONS_ENABLED
                                                       #profile {:dev        true
                                                                 :dev-no-rpi false
                                                                 :test       false
                                                                 :prod       true
                                                                 :default    true}]
                               :leds    #boolean #or [#env HARDWARE_LEDS_ENABLED
                                                       #profile {:dev        true
                                                                 :dev-no-rpi false
                                                                 :test       false
                                                                 :prod       true
                                                                 :default    true}]}

  :fairy.box.hardware/rfid    {:rfid-type #keyword #or [#env RFID_TYPE
                                                        #profile {:dev        "mfrc522"
                                                                  :dev-no-rpi "simulated"
                                                                  :test       "simulated"
                                                                  :prod       "mfrc522"
                                                                  :default    "mfrc522"}]
                               :mfrc522   {:controller  0
                                           :chip-select 0
                                           :reset-gpio  25}}

  :fairy.box.hardware/buttons {:buttons [{:gpio 22 :action :audio/prev}
                                         {:gpio 23 :action :audio/next}
                                         {:gpio 27 :action :audio/play-pause}
                                         {:gpio 5 :action :audio/volume-up}
                                         {:gpio 6 :action :audio/volume-down}
                                         {:gpio 17 :action :system/shutdown}]}

  :fairy.box.hardware/leds    {:leds   [{:gpio 14 :led-type :pwm :name :audio/prev}
                                        {:gpio 7 :led-type :pwm :name :audio/next}
                                        {:gpio 12 :led-type :pwm :name :audio/play-pause}
                                        {:gpio 13 :led-type :pwm :name :audio/volume-up}
                                        {:gpio 15 :led-type :pwm :name :audio/volume-down}]
                               :groups {}}

  :fairy.box.mqtt/client      {:uri       #or [#env MQTT_URI nil]
                               :mqtt-opts {:auto-reconnect     true
                                           :connection-timeout 5
                                           :username           #or [#env MQTT_USERNAME nil]
                                           :password           #or [#env MQTT_PASSWORD nil]}
                               :qos       2}

  :fairy.box.web/server       {:port #long #or [#env PORT 8080]}

  :fairy.box/startup          {:delay-ms #long #or [#env STARTUP_DELAY_MS 1000]}}}
